meta {
  name: Create category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "{{runTag}}"
  }
}

script:post-response {
  bru.setVar("categoryId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.archived: eq false
}
