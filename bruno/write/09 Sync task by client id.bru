meta {
  name: Sync task by client id
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/tasks/by-client-id/{{clientId}}
  body: json
  auth: none
}

body:json {
  {
    "description": "{{runTag}} synced",
    "category_id": null,
    "start_timestamp": "{{today}} 00:00:00",
    "finish_timestamp": "{{today}} 00:30:00"
  }
}

script:post-response {
  bru.setVar("syncedTaskId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.duration: eq 00:30:00
}

docs {
  What the desktop window sends: the full task state under its own UUID.
  201 creates the task, 200 replaces it.
}
