{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: local files, server requests, folder picker and opening the analytics site",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        }
      ]
    }
  ]
}
